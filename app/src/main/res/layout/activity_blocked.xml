<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:gravity="center" android:padding="32dp"
    android:background="#FFFFFF" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Take a pause" android:textSize="28sp" android:textStyle="bold"
        android:textColor="#17211D" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="ClearPath is protecting the boundary you set."
        android:textSize="16sp" android:gravity="center" android:textColor="#66716C"
        android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/backButton" android:text="Go back"
        android:layout_marginTop="24dp" android:layout_width="220dp" android:layout_height="52dp"/>
</LinearLayout>
